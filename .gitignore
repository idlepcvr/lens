# Environment & secrets
.env
*.env

# Database — the ledger and its WAL sidecars live in data/ since 2026-07-24.
# The whole directory is ignored: it holds the one irreplaceable file here and
# nothing in it belongs in git.
data/
*.db-shm
*.db-wal

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs — all of them live in logs/ since 2026-07-24 (systemd + the three cron
# jobs redirect there). The directory itself is tracked via logs/.gitkeep so a
# fresh clone has somewhere to write; without it the cron redirects fail.
*.log
logs/*
!logs/.gitkeep

# Node
node_modules/

# Screenshots (Week 6 deliverable)
data/screenshots/

# Generated strategy-board cache (refreshed by app.strategy_eval cron).
# The other results/ files ARE tracked — this one is a rebuildable cache.
results/strategy_scores.json

# local DB backups
data/backups/
.playwright-cli/

# stray 0-byte artifact from connecting to a bare relative "lens.db"
/lens.db

# git worktrees live here — never part of the repo itself
.claude/worktrees/
tmp/
